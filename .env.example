# Mintify API (for NFT holder data)
# Get your API key from Mintify dashboard
NEXT_PUBLIC_MINTIFY_API_KEY=your_mintify_api_key_here

# Base Chain RPC URL
# You can use public Base RPC or get a free one from Alchemy/Infura
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# Basescan API Key (optional, for enhanced transaction data)
# Get free API key from https://basescan.org/apis
BASESCAN_API_KEY=your_basescan_api_key_here

# Alchemy API Key (for token balance analysis)
# Get free API key from https://www.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Twitter/X API Credentials
# Get from https://developer.twitter.com/
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# NFT Collection Details
NEXT_PUBLIC_NFT_CONTRACT=0x61a85534f124781231BaB486b111534D9653f19a
NEXT_PUBLIC_CHAIN_ID=8453
